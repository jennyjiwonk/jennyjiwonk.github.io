<!--
  LOCAL OVERRIDE of al_folio_core's _includes/news.liquid.
  Change: news dates show as "Aug, 2026" (month + year) instead of "Aug 01, 2026"
  (month + day + year). Original line kept as a comment below. See
  docs/ARCHITECTURE.md#local-overrides-your-site-vs-this-repo. Run
  `bundle exec al-folio upgrade overrides diff _includes/news.liquid` after
  upgrading al_folio_core to check for upstream drift.
-->
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <!-- <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th> -->
            <th scope="row" style="width: 20%">{{ item.date | date: '%b, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
